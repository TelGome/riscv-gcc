RISCV_BUILTIN (abssi_p,     "abs",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_SI,     simd32),
RISCV_BUILTIN (absdi_p,     "abs",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_DI,     simd64),
RISCV_BUILTIN (absw_p,     "absw",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_SI,     simd64),
RISCV_BUILTIN (clssi_p,     "cls",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_SI,     simd32),
RISCV_BUILTIN (clsdi_p,     "cls",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_DI,     simd64),
RISCV_BUILTIN (clsw_p,     "clsw",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_SI,     simd64),
RISCV_BUILTIN (revsi_p,     "rev",  RISCV_BUILTIN_DIRECT, RISCV_USI_FTYPE_USI,     simd32),
RISCV_BUILTIN (revdi_p,     "rev",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI,     simd64),
RISCV_BUILTIN (rev16_p,     "rev16",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI,     simd64),
RISCV_BUILTIN (sha_p,     "sha",  RISCV_BUILTIN_DIRECT, RISCV_DI_FTYPE_DI_SI,     simd64),
RISCV_BUILTIN (shar_p,     "shar",  RISCV_BUILTIN_DIRECT, RISCV_DI_FTYPE_DI_SI,     simd64),
RISCV_BUILTIN (shl_p,     "shl",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_SI,     simd64),
RISCV_BUILTIN (shlr_p,     "shlr",  RISCV_BUILTIN_DIRECT, RISCV_UDI_FTYPE_UDI_SI,     simd64),

// Packed Splat
RISCV_BUILTIN (pmv_s_u8x4, "pmv_s_u8x4", RISCV_BUILTIN_DIRECT, RISCV_UV4QI_FTYPE_UQI, simd32),
RISCV_BUILTIN (pmv_s_i8x4, "pmv_s_i8x4", RISCV_BUILTIN_DIRECT, RISCV_V4QI_FTYPE_QI, simd32),
