RISCV_BUILTIN (pmv_s_i16x2, "pmv_s_i16x2", RISCV_BUILTIN_DIRECT, RISCV_V2HI_FTYPE_HI, simd32),
RISCV_BUILTIN (pmv_s_u8x8, "pmv_s_u8x8", RISCV_BUILTIN_DIRECT, RISCV_UV8QI_FTYPE_UQI, simd),
RISCV_BUILTIN (pmv_s_i8x8, "pmv_s_i8x8", RISCV_BUILTIN_DIRECT, RISCV_V8QI_FTYPE_QI, simd),
RISCV_BUILTIN (pmv_s_u16x4, "pmv_s_u16x4", RISCV_BUILTIN_DIRECT, RISCV_UV4HI_FTYPE_UHI, simd),
RISCV_BUILTIN (pmv_s_i16x4, "pmv_s_i16x4", RISCV_BUILTIN_DIRECT, RISCV_V4HI_FTYPE_HI, simd),
RISCV_BUILTIN (pmv_s_u32x2, "pmv_s_u32x2", RISCV_BUILTIN_DIRECT, RISCV_UV2SI_FTYPE_USI, simd),
RISCV_BUILTIN (pmv_s_i32x2, "pmv_s_i32x2", RISCV_BUILTIN_DIRECT, RISCV_V2SI_FTYPE_SI, simd),

